# .env.example — copy to .env and fill in real values before running the service.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Whisper STT
# ---------------------------------------------------------------------------
# Local Whisper model to load at startup.
# Options: tiny | base | small | medium | large | large-v3
WHISPER_MODEL=large-v3
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_FAST_NO_SPEECH_SKIP_THRESHOLD=0.55
WHISPER_MIN_AUDIO_BYTES=3200

# ---------------------------------------------------------------------------
# Anthropic LLM
# ---------------------------------------------------------------------------
# Your Anthropic API secret key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the system prompt sent to Claude.
# Default is a concise voice-assistant prompt.
LLM_SYSTEM_PROMPT=You are a helpful voice assistant. Keep responses concise and spoken-word friendly.

# ---------------------------------------------------------------------------
# MySQL — conversation history database
# ---------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=voicebot_user
MYSQL_PASSWORD=change_me_please
MYSQL_DB=voicebot

# ---------------------------------------------------------------------------
# Service (optional — used when running with uvicorn directly)
# ---------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
