# ---------------------------------------------------------------------------
# CosyVoice (unused — keep for reference)
# ---------------------------------------------------------------------------
COSYVOICE2_MODEL_PATH="D:\Technossus\Voice\STT-TTS\CosyVoice\pretrained_models\CosyVoice2-0.5B"

# ---------------------------------------------------------------------------
# Whisper STT (unused — Groq handles STT now, kept for reference)
# ---------------------------------------------------------------------------
WHISPER_MODEL=small
REMOTE_WHISPER_MODEL=distil-large-v3
REMOTE_WHISPER_MODEL=distil-large-v3
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_FAST_NO_SPEECH_SKIP_THRESHOLD=0.55
WHISPER_MIN_AUDIO_BYTES=3200

# ---------------------------------------------------------------------------
# LLM — Groq for low latency
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_API_KEY=gsk
LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_SYSTEM_PROMPT="You are a professional, calm, and reassuring healthcare assistant. Keep responses spoken-word friendly, precise, and limited to 40 words. Use clear punctuation like commas and periods to naturally guide a professional, measured pace. Avoid informal or overly cheerful filler words."

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DB=your_db

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
STT_PROMPT_FILE=prompts/stt_prompt.txt

# ---------------------------------------------------------------------------
# Kokoro TTS (unused — kept for reference)
# ---------------------------------------------------------------------------
KOKORO_DEVICE=cpu
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.25
KOKORO_SLOW_SPEED=0.85
KOKORO_EN_VOICE=af_heart
KOKORO_EN_LANG_CODE=a
KOKORO_HI_VOICE=hf_alpha
KOKORO_HI_LANG_CODE=h

# ---------------------------------------------------------------------------
# TTS Audio config — CRITICAL: must match WebRTC pipeline (16kHz)
# ---------------------------------------------------------------------------
TTS_TARGET_SAMPLE_RATE=16000

# ---------------------------------------------------------------------------
# Groq STT — Whisper via Groq LPU (~0.3s vs ~4s remote GPU)
# ---------------------------------------------------------------------------
GROQ_API_KEY=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
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ---------------------------------------------------------------------------
# TTS Provider — edge-tts only (Indian female voices)
# ---------------------------------------------------------------------------
TTS_PROVIDER=edge

# ---------------------------------------------------------------------------
# Edge TTS — Indian female voices, natural pace
# Speed guide: -10% = slower, +0% = natural, +10% = faster
# ---------------------------------------------------------------------------
EDGE_TTS_EN_VOICE=en-IN-NeerjaNeural
EDGE_TTS_HI_VOICE=hi-IN-SwaraNeural
EDGE_TTS_SPEED=+50%

# ---------------------------------------------------------------------------
# Shared audio / streaming config
# ---------------------------------------------------------------------------
TTS_COOLDOWN_MS=100
STT_MIN_AUDIO_MS=300
CLINICQUEUE_BASE_URL=https://ludie-silvicolous-indiscreetly.ngrok-free.dev
STREAMING_TTS_CHUNK_MS=20
STREAMING_TTS_MIN_CHUNK_MS=20
STREAMING_TTS_MAX_CHUNK_MS=200
TTS_MIN_SENTENCE_CHARS=5

# ---------------------------------------------------------------------------
# Filler audio — dead-air elimination between STT and LLM response
# ---------------------------------------------------------------------------
FILLER_ENABLED=true
FILLER_AUDIO_DIR=audio/fillers

KOKORO_EN_VOICE=af_heart
KOKORO_EN_LANG_CODE=a

KOKORO_HI_VOICE=hf_alpha
KOKORO_HI_LANG_CODE=h