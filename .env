# .env.example — copy to .env and fill in real values before running the service.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Whisper STT
# ---------------------------------------------------------------------------
# Local Whisper model to load at startup.
# Options: tiny | base | small | medium | large
# "base" is a good trade-off between speed and accuracy for a POC.
WHISPER_MODEL=base

# ---------------------------------------------------------------------------
# Ollama SLM
# ---------------------------------------------------------------------------
# SLM (Ollama)
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434/v1

# Default is a concise voice-assistant prompt.
LLM_SYSTEM_PROMPT=You are a helpful voice assistant. Keep responses concise and spoken-word friendly. Keep the response upto 45 words.

# ---------------------------------------------------------------------------
# MySQL — conversation history database
# ---------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DB=your_db

# ---------------------------------------------------------------------------
# Service (optional — used when running with uvicorn directly)
# ---------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
CLINICQUEUE_BASE_URL=http://localhost:5000
