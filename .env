LLM_PROVIDER=groq
LLM_API_KEY=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
LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=https://api.groq.com/openai/v1
