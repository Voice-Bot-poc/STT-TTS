# CosyVoice model path
COSYVOICE2_MODEL_PATH="D:\Technossus\Voice\STT-TTS\CosyVoice\pretrained_models\CosyVoice2-0.5B"
# .env.example — copy to .env and fill in real values before running the service.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Whisper STT
# ---------------------------------------------------------------------------
# Local Whisper model to load at startup.
# Options: tiny | base | small | medium | large | large-v3
WHISPER_MODEL=small
REMOTE_WHISPER_MODEL=distil-large-v3
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_FAST_NO_SPEECH_SKIP_THRESHOLD=0.55
WHISPER_MIN_AUDIO_BYTES=3200

# ---------------------------------------------------------------------------
# Ollama SLM
# ---------------------------------------------------------------------------
# SLM (Ollama)
LLM_PROVIDER=ollama
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434/v1

# Default is a concise voice-assistant prompt.
LLM_SYSTEM_PROMPT=You are a helpful voice assistant. Keep responses concise and spoken-word friendly. Keep the response upto 45 words.

# ---------------------------------------------------------------------------
# MySQL — conversation history database
# ---------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DB=your_db

# ---------------------------------------------------------------------------
# Service (optional — used when running with uvicorn directly)
# ---------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
CLINICQUEUE_BASE_URL=https://ludie-silvicolous-indiscreetly.ngrok-free.dev
STT_PROMPT_FILE=prompts/stt_prompt.txt

KOKORO_VOICE=af_heart
KOKORO_SPEED=1.25
KOKORO_SLOW_SPEED=0.85
TTS_TARGET_SAMPLE_RATE=32000

KOKORO_EN_VOICE=af_heart
KOKORO_EN_LANG_CODE=a

KOKORO_HI_VOICE=hf_alpha
KOKORO_HI_LANG_CODE=h