MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DB=your_db

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
CLINICQUEUE_BASE_URL=https://ludie-silvicolous-indiscreetly.ngrok-free.app
STT_PROMPT_FILE=prompts/stt_prompt.txt

# ---------------------------------------------------------------------------
# Kokoro TTS (unused — edge-tts handles TTS now, kept for reference)
# ---------------------------------------------------------------------------
KOKORO_DEVICE=cpu
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.25
KOKORO_SLOW_SPEED=0.85
KOKORO_EN_VOICE=af_heart
KOKORO_EN_LANG_CODE=a
KOKORO_HI_VOICE=hf_alpha
KOKORO_HI_LANG_CODE=h

# ---------------------------------------------------------------------------
# TTS Audio config — CRITICAL: must match WebRTC pipeline (16kHz)
# ---------------------------------------------------------------------------
TTS_TARGET_SAMPLE_RATE=16000

# ---------------------------------------------------------------------------
# Groq STT — Whisper via Groq LPU (~0.3s vs ~4s remote GPU)
# ---------------------------------------------------------------------------
GROQ_API_KEY=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
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ---------------------------------------------------------------------------
# Edge TTS — Microsoft Neural voices, no GPU needed (~0.3s)
# ---------------------------------------------------------------------------
EDGE_TTS_EN_VOICE=en-US-AriaNeural
EDGE_TTS_HI_VOICE=hi-IN-SwaraNeural
EDGE_TTS_SPEED=-5%